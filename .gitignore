# ─────────────────────────────
# Entorno virtual
# ─────────────────────────────
venv/
.venv/
ENV/
env/

# ─────────────────────────────
# Archivos de Python
# ─────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb

# ─────────────────────────────
# Archivos de configuración locales
# ─────────────────────────────
*.env
.env.*
*.ini
*.cfg
*.local
*.log

# ─────────────────────────────
# Archivos de Flask
# ─────────────────────────────
instance/
.flaskenv

# Datos locales y copias de SQLite, aunque se guarden fuera de instance
*.sqlite
*.sqlite3
*.db
*.sqlite-*
*.sqlite3-*
*.db-*
session.key
uploads/
backups/
respaldos/

# ─────────────────────────────
# Archivos de tu proyecto
# ─────────────────────────────
static/*
!static/.gitkeep
templates/__pycache__/

# Imágenes y videos cargados o usados como prueba
# La imagen compartida incluida con el programa sí pertenece al repositorio
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[gG][iI][fF]
*.[wW][eE][bB][pP]
*.[mM][pP]4
*.[wW][eE][bB][mM]
!assets/ley-silla.png

# Manuales y otros documentos generados localmente
entregables/

# ─────────────────────────────
# Archivos de editor/IDE
# ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─────────────────────────────
# Archivos del sistema
